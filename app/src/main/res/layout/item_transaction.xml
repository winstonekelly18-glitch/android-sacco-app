<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp">

    <LinearLayout android:gravity="center_vertical" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="horizontal" android:padding="16dp">

        <TextView android:id="@+id/tvTxType" android:layout_height="wrap_content" android:layout_weight="1" android:layout_width="0dp" android:text="Deposit" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/>

        <TextView android:id="@+id/tvTxAmount" android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="+ KES 500.00" android:textColor="@color/green_deposit" android:textSize="16sp" android:textStyle="bold"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>